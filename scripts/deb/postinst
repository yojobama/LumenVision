#!/bin/sh
# lumenvision-backend .deb postinst - creates the lumen user, fixes permissions and starts the service
set -e

case "$1" in
    configure)
        if ! id lumen >/dev/null 2>&1; then
            useradd --system --no-create-home --shell /usr/sbin/nologin lumen
        fi
        # video/render: /dev/dri (Vulkan/rkmpp) and /dev/mpp_service access
        usermod -aG video,render lumen
        chown -R lumen:lumen /opt/lumenvision

        # Reapply the packaged udev rule; device nodes are otherwise root-only and RGA/MPP init fails
        udevadm control --reload-rules || true
        udevadm trigger --subsystem-match=dma_heap 2>/dev/null || true
        udevadm trigger --sysname-match=mpp_service 2>/dev/null || true
        udevadm trigger --sysname-match=rga 2>/dev/null || true
        # devfreq governor rule (GPU/memory/NPU): applies at boot on a real system; the trigger covers an install onto a running one
        udevadm trigger --subsystem-match=devfreq --action=add 2>/dev/null || true

        # The lumen user gets passwordless sudo: the device settings page (network, hostname, reboot, updates) runs privileged commands through
        # it. The API is unauthenticated, so anyone who can reach the server can trigger those. The rule is written to a temporary file and only
        # installed if visudo accepts it, so a bad file can never lock sudo out.
        SUDOERS_TMP=/etc/sudoers.d/.lumenvision.tmp
        printf 'lumen ALL=(ALL) NOPASSWD: ALL\n' > "$SUDOERS_TMP"
        chmod 0440 "$SUDOERS_TMP"
        if visudo -cf "$SUDOERS_TMP" >/dev/null 2>&1; then
            mv "$SUDOERS_TMP" /etc/sudoers.d/lumenvision
        else
            rm -f "$SUDOERS_TMP"
            echo "lumenvision: could not validate the sudoers rule; device settings that need root will not work" >&2
        fi

        systemctl daemon-reload
        systemctl enable lumenvision.service
        # restart so an upgrade picks up the new binary
        systemctl restart lumenvision.service || true
        ;;
esac

exit 0
