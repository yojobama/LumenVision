[Unit]
Description=LumenVision vision coprocessor server
After=network-online.target
Wants=network-online.target
# PhotonVision and LumenVision both need exclusive access to the camera devices and CPU/NPU
Conflicts=photonvision.service

[Service]
Type=simple
User=lumen
Group=lumen
# Access to /dev/dri (Vulkan/rkmpp) and /dev/mpp_service (rkmpp encode)
SupplementaryGroups=video render

WorkingDirectory=/opt/lumenvision
ExecStart=/opt/lumenvision/Server
Restart=always
RestartSec=2

# Every thread runs at nice -19, so threads started later by web requests get the same CPU share as boot-time ones.
Nice=-19

# libLumenCore.so sits next to the Server binary
Environment=LD_LIBRARY_PATH=/opt/lumenvision

# Pins the Vulkan ICD to the libmali driver; install-deps.sh install_vulkan() writes a drop-in
# (lumenvision.service.d/10-vulkan-icd.conf) overriding this with the ICD registered on the board
Environment=VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/mali.json

# OpenCV's worker threads spin (pause, then sched_yield) for 2000 iterations after every parallel job before they sleep. With parallel calls arriving every few
# milliseconds across the pipeline that was 8% of the service's CPU on an Orange Pi 5 Plus with two cameras (2.13 cores down to 1.81 with it off, no stage slower,
# the performance cores 48% busy down to 41%). The main thread's own spin stays: turning that off as well saved nothing and slowed the detectors' short calls.
# OpenCV reads this when its library loads, so it has to be in the process environment.
Environment=OPENCV_THREAD_POOL_ACTIVE_WAIT_WORKER=0

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lumenvision

[Install]
WantedBy=multi-user.target
