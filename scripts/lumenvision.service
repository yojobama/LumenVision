[Unit]
Description=LumenVision vision coprocessor server
After=network-online.target
Wants=network-online.target
# PhotonVision and LumenVision both need exclusive access to the camera devices and CPU/NPU
Conflicts=photonvision.service

[Service]
Type=simple
User=lumen
Group=lumen
# Access to /dev/dri (Vulkan/rkmpp) and /dev/mpp_service (rkmpp encode)
SupplementaryGroups=video render

WorkingDirectory=/opt/lumenvision
ExecStart=/opt/lumenvision/Server
Restart=always
RestartSec=2

# One CPU priority for every thread. A thread inherits its creator's nice value, and the NPU runtime raises the thread that loads a model
# to -19 without being asked (a process holding no capabilities cannot do that itself), so a pipeline started at boot ran at -19 while one
# started later from a web request (an ASP.NET thread, nice 0) got a small fraction of the CPU: restarting or rebuilding a detector made it 30-60%
# slower until the next service restart (measured: Vulkan AprilTag 30 -> 48 ms, RKNN 35 -> 41 ms of frame age). -19 for the whole service
# makes them all equal and matches what the boot-time threads already had.
Nice=-19

# libLumenCore.so sits next to the Server binary
Environment=LD_LIBRARY_PATH=/opt/lumenvision

# Pins the Vulkan ICD to the libmali driver; install-deps.sh install_vulkan() writes a drop-in
# (lumenvision.service.d/10-vulkan-icd.conf) overriding this with the ICD registered on the board
Environment=VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/mali.json

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lumenvision

[Install]
WantedBy=multi-user.target
