[Unit]
Description=LumenVision vision coprocessor server
After=network-online.target
Wants=network-online.target
# PhotonVision and LumenVision both need exclusive access to the camera devices and CPU/NPU
Conflicts=photonvision.service

[Service]
Type=simple
User=lumen
Group=lumen
# Access to /dev/dri (Vulkan/rkmpp) and /dev/mpp_service (rkmpp encode)
SupplementaryGroups=video render

WorkingDirectory=/opt/lumenvision
ExecStart=/opt/lumenvision/Server
Restart=always
RestartSec=2

# libLumenCore.so sits next to the Server binary
Environment=LD_LIBRARY_PATH=/opt/lumenvision

# Pins the Vulkan ICD to the libmali driver; install-deps.sh install_vulkan() writes a drop-in
# (lumenvision.service.d/10-vulkan-icd.conf) overriding this with the ICD registered on the board
Environment=VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/mali.json

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lumenvision

[Install]
WantedBy=multi-user.target
