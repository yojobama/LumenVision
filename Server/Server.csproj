<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;LocalCheck</Configurations>
    <!-- wwwroot Content items are declared explicitly below, so the default glob would duplicate them (NETSDK1022). -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>

    <!-- The Pi deploy image has no libicu and a self-contained publish does not bundle it; invariant mode avoids the dependency. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      LumenCore is built by CMake, so it is consumed as a prebuilt native library rather than a <ProjectReference>.
      Override LumenCorePreset (e.g. -p:LumenCorePreset=pi-arm64-release) to select a different build.
    -->
    <!-- The preset comes from $(RuntimeIdentifier) first; $(OS) (the build host, not the target) is only a fallback when RID is unset. -->
    <LumenCorePresetBase Condition="'$(LumenCorePresetBase)'=='' And '$(RuntimeIdentifier)'=='linux-arm64'">pi-arm64</LumenCorePresetBase>
    <LumenCorePresetBase Condition="'$(LumenCorePresetBase)'=='' And '$(RuntimeIdentifier)'=='linux-x64'">wsl-x64</LumenCorePresetBase>
    <LumenCorePresetBase Condition="'$(LumenCorePresetBase)'=='' And $([MSBuild]::ValueOrDefault('$(RuntimeIdentifier)', '').StartsWith('win'))">windows-x64</LumenCorePresetBase>
    <LumenCorePresetBase Condition="'$(LumenCorePresetBase)'=='' And '$(OS)'=='Windows_NT'">windows-x64</LumenCorePresetBase>
    <LumenCorePresetBase Condition="'$(LumenCorePresetBase)'==''">wsl-x64</LumenCorePresetBase>

    <!-- Preset names are lowercase; the stage subdirectory is title-case (Debug/Release). Non-Release configurations map to Debug. -->
    <LumenCoreConfigLower Condition="'$(Configuration)'=='Release'">release</LumenCoreConfigLower>
    <LumenCoreConfigLower Condition="'$(Configuration)'!='Release'">debug</LumenCoreConfigLower>
    <LumenCoreConfigTitle Condition="'$(Configuration)'=='Release'">Release</LumenCoreConfigTitle>
    <LumenCoreConfigTitle Condition="'$(Configuration)'!='Release'">Debug</LumenCoreConfigTitle>

    <LumenCorePreset Condition="'$(LumenCorePreset)'==''">$(LumenCorePresetBase)-$(LumenCoreConfigLower)</LumenCorePreset>
    <LumenCoreStageDir>$(MSBuildThisFileDirectory)..\out\build\$(LumenCorePreset)\stage\$(LumenCoreConfigTitle)</LumenCoreStageDir>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Server.Tests" />
    <Folder Include="Interop\" />
  </ItemGroup>

  <!-- ASP.NET Core (Kestrel + MVC) comes from the Microsoft.NET.Sdk.Web shared framework.
       UseSystemd() provides sd_notify/SIGTERM handling under lumenvision.service. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.0" />
    <!-- GPIO access (libgpiod) for the vision LED; unused unless an LED is configured -->
    <PackageReference Include="System.Device.Gpio" Version="4.0.1" />
  </ItemGroup>

  <!--
    Globs the CMake stage directory for the native library and every DLL it depends on.
    CopyToOutputDirectory is Always because PreserveNewest can leave a wrong-architecture library from an earlier preset in the output.
  -->
  <ItemGroup>
    <!-- *.so* also matches versioned SONAMEs and symlinks (e.g. libopencv_core.so.5.0.0, libapriltag.so.3) staged by CopyLinuxRuntimeDeps.cmake. -->
    <LumenCoreStageFiles Include="$(LumenCoreStageDir)\*.so*;$(LumenCoreStageDir)\*.dll" Condition="Exists('$(LumenCoreStageDir)')" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="@(LumenCoreStageFiles)">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    SWIG bindings use [DllImport("libLumenCore")] but Windows builds LumenCore.dll; this alias copy gives P/Invoke the name it loads.
  -->
  <ItemGroup Condition="Exists('$(LumenCoreStageDir)\LumenCore.dll')">
    <Content Include="$(LumenCoreStageDir)\LumenCore.dll">
      <Link>libLumenCore.dll</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    The React WebUI (webui, built with npm run build) is served by Program.cs from wwwroot; included only if webui\dist exists.
  -->
  <ItemGroup>
    <Content Include="wwwroot\**" Exclude="wwwroot\dist\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- the AprilTag field layouts shipped with the server (see field-layouts/README.md) -->
    <Content Include="..\field-layouts\*.json">
      <Link>fieldLayouts\bundled\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\webui\dist\**" Condition="Exists('..\webui\dist')">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Builds LumenCore via CMake before Server. Skipped with a warning when cmake is not on PATH or the preset is unconfigured;
    CheckLumenCoreExists fails the build if the native library is missing.
  -->
  <Target Name="BuildLumenCore" BeforeTargets="BeforeBuild">
    <Exec Command="where cmake" Condition="'$(OS)'=='Windows_NT'" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="CMakeCheckExitCode" />
    </Exec>
    <Exec Command="command -v cmake" Condition="'$(OS)'!='Windows_NT'" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="CMakeCheckExitCode" />
    </Exec>
    <PropertyGroup>
      <LumenCoreConfigured>false</LumenCoreConfigured>
      <LumenCoreConfigured Condition="Exists('$(MSBuildThisFileDirectory)..\out\build\$(LumenCorePreset)\CMakeCache.txt')">true</LumenCoreConfigured>
    </PropertyGroup>
    <Exec Command="cmake --build --preset $(LumenCorePreset)"
          WorkingDirectory="$(MSBuildThisFileDirectory).."
          Condition="'$(CMakeCheckExitCode)'=='0' And '$(LumenCoreConfigured)'=='true'" />
    <Warning Text="cmake not found on PATH; using whatever LumenCore build already exists for preset '$(LumenCorePreset)'."
             Condition="'$(CMakeCheckExitCode)'!='0'" />
    <Warning Text="Preset '$(LumenCorePreset)' has never been configured (no CMakeCache.txt under out/build/$(LumenCorePreset)) - run `cmake --preset $(LumenCorePreset)` first. Using whatever build already exists, if any."
             Condition="'$(CMakeCheckExitCode)'=='0' And '$(LumenCoreConfigured)'!='true'" />
  </Target>

  <!--
    Fails the build if the native library is missing or the Interop bindings lack the .swig-stamp written by a CMake configure,
    which would otherwise surface only as a runtime DllNotFoundException/EntryPointNotFoundException.
  -->
  <Target Name="CheckLumenCoreExists" BeforeTargets="Build;Publish">
    <ItemGroup>
      <_LumenCoreNativeLib Include="$(LumenCoreStageDir)\libLumenCore.so" Condition="Exists('$(LumenCoreStageDir)\libLumenCore.so')" />
      <_LumenCoreNativeLib Include="$(LumenCoreStageDir)\LumenCore.dll" Condition="Exists('$(LumenCoreStageDir)\LumenCore.dll')" />
    </ItemGroup>
    <Error Text="LumenCore native library not found under '$(LumenCoreStageDir)' for preset '$(LumenCorePreset)'. Build it first: cmake --preset $(LumenCorePreset) &amp;&amp; cmake --build --preset $(LumenCorePreset) - or override -p:LumenCorePreset=/-p:LumenCorePresetBase=."
           Condition="'@(_LumenCoreNativeLib)'==''" />
    <Error Text="Server/Interop/.swig-stamp not found - the C# bindings next to the native library above were never generated by an actual CMake configure. Run: cmake --preset $(LumenCorePreset)"
           Condition="!Exists('$(MSBuildThisFileDirectory)Interop\.swig-stamp')" />
  </Target>

</Project>
